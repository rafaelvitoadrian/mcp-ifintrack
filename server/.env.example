# Konfigurasi Server MCP Financial Tracker (JANGAN commit password atau token nyata!)
FINTRACK_API_BASE_URL=http://127.0.0.1:9090
FINTRACK_SCHEDULE_BASE_URL=http://127.0.0.1:9091
FINTRACK_TIMEZONE=Asia/Jakarta

# Port untuk transport Streamable HTTP (npm run start:http)
PORT=3000
# Opsional: Daftar origin yang diizinkan untuk Streamable HTTP (dipisah koma)
FINTRACK_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Batas waktu persetujuan preview mutasi (default 15 menit = 900000 ms)
APPROVAL_TIMEOUT_MS=900000
# Timeout baca (30 detik) dan tulis (240 detik sesuai durasi createMasterAndRevision backend)
REQUEST_TIMEOUT_MS=30000
WRITE_TIMEOUT_MS=240000
MAX_RESULT_SIZE=48000

# Direktori khusus yang diizinkan sebagai sumber upload_file (opsional)
FINTRACK_UPLOAD_DIR=

# Kredensial sesi lokal untuk transport stdio (disediakan oleh mekanisme rahasia host per sesi)
# Jangan pernah mengisi password atau token produksi di dalam file yang di-commit ke git!
FINTRACK_EMAIL=
FINTRACK_PASSWORD=
FINTRACK_TOKEN=
